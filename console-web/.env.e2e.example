# Example env for console e2e (do not commit secrets)
E2E_USERNAME=ci-console
E2E_PASSWORD=CHANGE_ME

KEYCLOAK_ISSUER=https://auth.truffles.kz/realms/truffles
KEYCLOAK_CLIENT_ID=console-web
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

NEXTAUTH_URL=https://console.truffles.kz
NEXTAUTH_SECRET=CHANGE_ME
NEXT_PUBLIC_API_URL=https://api.truffles.kz/console/v1
# Rollout guard: set to 0 for legacy/base tenants mode.
NEXT_PUBLIC_TENANTS_V3_CONTROL_TOWER=1

PLAYWRIGHT_BASE_URL=https://console.truffles.kz
PLAYWRIGHT_WEB_SERVER=0
