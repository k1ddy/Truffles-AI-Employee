#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
"$repo_root/scripts/session_check.sh"

remote_name="${1:-}"
remote_url="${2:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "$local_ref" ]] && continue
  if [[ "$remote_ref" != refs/heads/* ]]; then
    continue
  fi
  target_branch="${remote_ref#refs/heads/}"
  "$repo_root/scripts/session_gate.sh" --mode pre-push --target-branch "$target_branch" --base "$remote_sha" --head "$local_sha"
done

exit 0
