# OpenAI
OPENAI_API_KEY=
FAST_MODEL=gpt-5.4-nano-2026-03-17
SLOW_MODEL=gpt-5.4-nano-2026-03-17
ROUTER_MODEL=gpt-5.4-nano-2026-03-17
LLM_PLAN_MODEL=gpt-5.4-nano-2026-03-17
FAST_MODEL_MAX_CHARS=160
INTENT_TIMEOUT_SECONDS=1.5
LLM_TIMEOUT_SECONDS=4
LLM_MAX_TOKENS=600
LLM_HISTORY_MESSAGES=6
LLM_KNOWLEDGE_CHARS=1500
LLM_SEMANTIC_OWNER_MODEL=gpt-5.4-nano-2026-03-17
LLM_POLICY_CORE_MODEL=gpt-5.4-nano-2026-03-17
LLM_POLICY_CORE_TIMEOUT_SECONDS=15.0
LLM_POLICY_CORE_TIMEOUT_RETRY_SECONDS=8.0
LLM_POLICY_CORE_TIMEOUT_FALLBACK_SECONDS=6.0
LLM_POLICY_CORE_TIMEOUT_FALLBACK_MODEL=gpt-5.4-nano-2026-03-17
LLM_POLICY_CORE_REASONING_EFFORT=low
LLM_POLICY_CORE_GPT5_MIN_MAX_TOKENS=800
LLM_SPECIALIST_HINT_MODEL=gpt-5.4-nano-2026-03-17
LLM_CUSTOMER_NAME_HINT_MODEL=gpt-5.4-nano-2026-03-17
LLM_SERVICE_QUERY_HINT_MODEL=gpt-5.4-nano-2026-03-17
ANSWER_INTERPRETER_MODEL=gpt-5.4-nano-2026-03-17
LLM_TIMEOUT_FALLBACK_MODEL=gpt-5.4-nano-2026-03-17
LLM_CACHE_ENABLED=1
LLM_CACHE_TTL_SECONDS=86400
LLM_CACHE_SOCKET_TIMEOUT_SECONDS=0.3
POLICY_VERSION=v1

# Audio transcription (ASR)
AUDIO_TRANSCRIPTION_ENABLED=0
AUDIO_TRANSCRIPTION_MAX_MB=2
AUDIO_TRANSCRIPTION_MODEL=whisper-1
AUDIO_TRANSCRIPTION_LANGUAGE=
ASR_PRIMARY_PROVIDER=elevenlabs
ASR_FALLBACK_PROVIDER=openai_whisper
ASR_ELEVENLABS_MODEL_ID=scribe_v1
ASR_TIMEOUT_SECONDS=6
ASR_MIN_CHARS=12
ELEVENLABS_API_KEY=

# Outbox
OUTBOX_WORKER_ENABLED=1
OUTBOX_WORKER_MODE=prod
OUTBOX_WORKER_INTERVAL_SECONDS=1
OUTBOX_COALESCE_SECONDS=1
OUTBOX_WINDOW_MERGE_SECONDS=2.5

# Runtime modes
EVAL_MODE=prod
TRANSPORT_SEND_MODE=prod

# Legacy compatibility (prefer the explicit runtime modes above)
TEST_MODE=0
OUTBOUND_ALLOWLIST_JIDS=77015705555@s.whatsapp.net

# Qdrant
QDRANT_HOST=http://qdrant:6333
QDRANT_API_KEY=

# BGE-M3 Embedding Service
BGE_M3_URL=http://bge-m3:80/embed

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/chatbot
