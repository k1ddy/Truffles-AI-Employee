{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truffles.ai/contracts/events/inbox_event.v1.jsonschema",
  "title": "Inbox Event v1",
  "type": "object",
  "required": [
    "event_id",
    "tenant_context",
    "provider",
    "channel",
    "provider_message_id",
    "received_at",
    "raw_ref"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_context": {
      "$ref": "../tenancy/tenant_context.v1.jsonschema"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "provider_message_id": {
      "type": "string",
      "minLength": 1
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_ref": {
      "type": "string",
      "minLength": 1
    },
    "dedupe_key": {
      "type": ["string", "null"]
    },
    "status": {
      "type": ["string", "null"],
      "enum": ["received", "validated", "deduped", "processed", "failed", null]
    },
    "status_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "extensions": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
