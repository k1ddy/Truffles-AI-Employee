{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truffles.ai/contracts/runtime/dialog_state.v1.jsonschema",
  "title": "DialogState v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "current_referents",
    "pending_question_contract",
    "interaction_state",
    "projections",
    "meta"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "dialog_state.v1"
    },
    "semantic_state": {
      "$ref": "#/$defs/canonicalSemanticState"
    },
    "current_referents": {
      "$ref": "#/$defs/currentReferents"
    },
    "pending_question_contract": {
      "$ref": "#/$defs/pendingQuestionContract"
    },
    "interaction_state": {
      "$ref": "#/$defs/interactionState"
    },
    "projections": {
      "$ref": "#/$defs/projections"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "nullableToken": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "currentReferents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "specialist", "branch", "booking", "customer"],
      "properties": {
        "service": {
          "$ref": "#/$defs/nullableToken"
        },
        "specialist": {
          "$ref": "#/$defs/nullableToken"
        },
        "branch": {
          "$ref": "#/$defs/nullableToken"
        },
        "booking": {
          "$ref": "#/$defs/nullableToken"
        },
        "customer": {
          "$ref": "#/$defs/nullableToken"
        }
      }
    },
    "pendingQuestionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_reply_type",
        "reason",
        "pending_question_act",
        "pending_question_target",
        "active_question_relation",
        "next_question",
        "open_questions"
      ],
      "properties": {
        "expected_reply_type": {
          "$ref": "#/$defs/nullableToken"
        },
        "reason": {
          "$ref": "#/$defs/nullableToken"
        },
        "pending_question_act": {
          "$ref": "#/$defs/nullableToken"
        },
        "pending_question_target": {
          "$ref": "#/$defs/nullableToken"
        },
        "active_question_relation": {
          "$ref": "#/$defs/nullableToken"
        },
        "next_question": {
          "$ref": "#/$defs/nullableToken"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interactionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resume_slot",
        "interaction_target",
        "interaction_relation",
        "interaction_owner",
        "grounded_referents",
        "confirmation_state",
        "degrade_reason"
      ],
      "properties": {
        "resume_slot": {
          "$ref": "#/$defs/nullableToken"
        },
        "interaction_target": {
          "$ref": "#/$defs/nullableToken"
        },
        "interaction_relation": {
          "$ref": "#/$defs/nullableToken"
        },
        "interaction_owner": {
          "$ref": "#/$defs/nullableToken"
        },
        "grounded_referents": {
          "$ref": "#/$defs/stringMap"
        },
        "confirmation_state": {
          "$ref": "#/$defs/nullableToken"
        },
        "degrade_reason": {
          "$ref": "#/$defs/nullableToken"
        }
      }
    },
    "projections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_reply_type", "expected_reply_reason", "session_memory_interaction_state"],
      "properties": {
        "expected_reply_type": {
          "$ref": "#/$defs/nullableToken"
        },
        "expected_reply_reason": {
          "$ref": "#/$defs/nullableToken"
        },
        "session_memory_interaction_state": {
          "$ref": "#/$defs/interactionState"
        }
      }
    },
    "semanticFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "subject",
        "referents",
        "constraints",
        "preferences",
        "continuation",
        "capability_selection",
        "needs_human"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "semantic_frame.v2"
        },
        "user_goal": {
          "$ref": "#/$defs/nullableToken"
        },
        "requested_effect": {
          "$ref": "#/$defs/nullableToken"
        },
        "subject": {
          "type": "object",
          "additionalProperties": true
        },
        "referents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        },
        "preferences": {
          "type": "object",
          "additionalProperties": true
        },
        "continuation": {
          "type": "object",
          "additionalProperties": true
        },
        "capability_selection": {
          "type": "object",
          "additionalProperties": true
        },
        "needs_human": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/nullableToken"
        }
      }
    },
    "semanticStateEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "source",
        "outcome",
        "action",
        "intent",
        "tool_action",
        "reason_code",
        "semantic_frame"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/nullableToken"
        },
        "source": {
          "$ref": "#/$defs/nullableToken"
        },
        "outcome": {
          "$ref": "#/$defs/nullableToken"
        },
        "action": {
          "$ref": "#/$defs/nullableToken"
        },
        "intent": {
          "$ref": "#/$defs/nullableToken"
        },
        "tool_action": {
          "$ref": "#/$defs/nullableToken"
        },
        "reason_code": {
          "$ref": "#/$defs/nullableToken"
        },
        "semantic_frame": {
          "$ref": "#/$defs/semanticFrame"
        }
      }
    },
    "canonicalSemanticState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "materialized_frame", "event_log"],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "canonical_semantic_state.v1"
        },
        "materialized_frame": {
          "$ref": "#/$defs/semanticFrame"
        },
        "event_log": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticStateEvent"
          }
        }
      }
    }
  }
}
