{
  "$defs": {
    "RuntimeTraceActionTransitionV1": {
      "additionalProperties": false,
      "properties": {
        "contract_action": {
          "title": "Contract Action",
          "type": "string"
        },
        "runtime_entrypoint": {
          "title": "Runtime Entrypoint",
          "type": "string"
        },
        "semantic_runtime_path": {
          "title": "Semantic Runtime Path",
          "type": "string"
        },
        "reply_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply Kind"
        },
        "delivered": {
          "default": false,
          "title": "Delivered",
          "type": "boolean"
        },
        "execution_tool_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Tool Action"
        },
        "execution_tool_decision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Tool Decision"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "earliest_failed_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earliest Failed Stage"
        },
        "root_reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Reason Code"
        }
      },
      "required": [
        "contract_action",
        "runtime_entrypoint",
        "semantic_runtime_path"
      ],
      "title": "RuntimeTraceActionTransitionV1",
      "type": "object"
    },
    "RuntimeTraceBindingTransitionV1": {
