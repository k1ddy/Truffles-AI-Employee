{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truffles.ai/contracts/runtime/policy_decision.v1.jsonschema",
  "title": "PolicyDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "action",
    "intent",
    "source",
    "tool_action",
    "tool_args",
    "slots",
    "pack_refs",
    "fact_refs",
    "interaction",
    "pending_question_contract",
    "meta"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "policy_decision.v1"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "FACT",
        "COLLECT",
        "HANDOFF"
      ]
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "const": "policy_core"
    },
    "tool_action": {
      "type": "string",
      "minLength": 1
    },
    "tool_args": {
      "type": "object",
      "additionalProperties": true
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pack_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capability_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "risk_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "interaction": {
      "$ref": "#/$defs/interaction"
    },
    "semantic_frame": {
      "$ref": "#/$defs/semanticFrame"
    },
    "pending_question_contract": {
      "$ref": "#/$defs/pendingQuestionContract"
    },
    "semantic_decision": {
      "anyOf": [
        {
          "$ref": "https://truffles.ai/contracts/runtime/semantic_decision.v1.jsonschema"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "binding_plan": {
      "anyOf": [
        {
          "$ref": "https://truffles.ai/contracts/runtime/binding_plan.v1.jsonschema"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "nullableToken": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "target",
        "relation"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/nullableToken"
        },
        "relation": {
          "$ref": "#/$defs/nullableToken"
        }
      }
    },
    "pendingQuestionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_reply_type",
        "reason",
        "pending_question_act",
        "pending_question_target",
        "active_question_relation",
        "next_question",
        "open_questions"
      ],
      "properties": {
        "expected_reply_type": {
          "$ref": "#/$defs/nullableToken"
        },
        "reason": {
          "$ref": "#/$defs/nullableToken"
        },
        "pending_question_act": {
          "$ref": "#/$defs/nullableToken"
        },
        "pending_question_target": {
          "$ref": "#/$defs/nullableToken"
        },
        "active_question_relation": {
          "$ref": "#/$defs/nullableToken"
        },
        "next_question": {
          "$ref": "#/$defs/nullableToken"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "semanticFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "subject",
        "referents",
        "constraints",
        "preferences",
        "continuation",
        "capability_selection",
        "needs_human"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "semantic_frame.v2"
        },
        "user_goal": {
          "$ref": "#/$defs/nullableToken"
        },
        "requested_effect": {
          "$ref": "#/$defs/nullableToken"
        },
        "subject": {
          "type": "object",
          "additionalProperties": true
        },
        "referents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": true
        },
        "preferences": {
          "type": "object",
          "additionalProperties": true
        },
        "continuation": {
          "type": "object",
          "additionalProperties": true
        },
        "capability_selection": {
          "type": "object",
          "additionalProperties": true
        },
        "needs_human": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/nullableToken"
        }
      }
    },
    "shadowSemanticFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "subject",
        "referents",
        "constraints",
        "preferences",
        "continuation",
        "capability_selection",
        "needs_human",
        "user_goal",
        "requested_effect",
        "reason"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "semantic_frame.v2"
        },
        "user_goal": {
          "type": "null"
        },
        "requested_effect": {
          "type": "null"
        },
        "subject": {
          "const": {}
        },
        "referents": {
          "const": {}
        },
        "constraints": {
          "const": {}
        },
        "preferences": {
          "const": {}
        },
        "continuation": {
          "const": {}
        },
        "capability_selection": {
          "const": {}
        },
        "needs_human": {
          "const": false
        },
        "reason": {
          "type": "null"
        }
      }
    },
    "shadowPendingQuestionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_reply_type",
        "reason",
        "pending_question_act",
        "pending_question_target",
        "active_question_relation",
        "next_question",
        "open_questions"
      ],
      "properties": {
        "expected_reply_type": {
          "type": "null"
        },
        "reason": {
          "type": "null"
        },
        "pending_question_act": {
          "type": "null"
        },
        "pending_question_target": {
          "type": "null"
        },
        "active_question_relation": {
          "type": "null"
        },
        "next_question": {
          "type": "null"
        },
        "open_questions": {
          "const": []
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "semantic_decision"
        ],
        "properties": {
          "semantic_decision": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "binding_plan": {
            "$ref": "https://truffles.ai/contracts/runtime/binding_plan.v1.jsonschema"
          },
          "semantic_frame": {
            "$ref": "#/$defs/shadowSemanticFrame"
          },
          "pending_question_contract": {
            "$ref": "#/$defs/shadowPendingQuestionContract"
          },
          "meta": {
            "not": {
              "required": [
                "semantic_contract"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "meta": {
            "type": "object",
            "required": [
              "synthetic_policy_decision"
            ],
            "properties": {
              "synthetic_policy_decision": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "binding_plan": {
            "$ref": "https://truffles.ai/contracts/runtime/binding_plan.v1.jsonschema"
          }
        }
      }
    }
  ]
}
