          "items": {
            "type": "string"
          },
          "title": "Blocked Scopes",
          "type": "array"
        },
        "bundle_policy": {
          "default": "requested_only",
          "title": "Bundle Policy",
          "type": "string"
        },
        "scope_policy_source": {
          "default": "default",
