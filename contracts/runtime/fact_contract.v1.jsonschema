          "title": "Manifest Id",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "binding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Id"
        },
        "selected_tool_or_workflow_ref": {
          "title": "Selected Tool Or Workflow Ref",
          "type": "string"
        },
        "selected_resolver": {
          "title": "Selected Resolver",
          "type": "string"
        },
