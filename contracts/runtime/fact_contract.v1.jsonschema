        },
        "requested_fact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Requested Fact Refs",
          "type": "array"
        },
        "requested_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Requested Scopes",
          "type": "array"
        },
        "composition_mode": {
          "default": "single_only",
          "enum": [
            "single_only",
            "companion_allowed",
            "bundle_required"
          ],
          "title": "Composition Mode",
          "type": "string"
        },
        "allowed_emitted_sets": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Allowed Emitted Sets",
