          "type": "string"
        },
        "provenance_sources": {
          "items": {
            "type": "string"
          },
          "title": "Provenance Sources",
          "type": "array"
        }
      },
      "required": [
        "manifest_id",
        "request_id",
        "decision_id",
        "selected_tool_or_workflow_ref",
        "selected_resolver"
      ],
      "title": "FactPlanV1",
      "type": "object"
    },
