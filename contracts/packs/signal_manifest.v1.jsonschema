{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truffles.local/contracts/packs/signal_manifest.v1.jsonschema",
  "title": "Signal Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "booking",
    "info"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "signal_manifest.v1"
    },
    "booking": {
      "type": "object",
      "required": [
        "regex",
        "replacement_patterns",
        "tokens",
        "layout_swap_map"
      ],
      "additionalProperties": false,
      "properties": {
        "regex": {
          "type": "object",
          "required": [
            "phone_pattern",
            "booking_hour_fallback_pattern",
            "time_token_pattern",
            "daypart_token_pattern",
            "specialist_prefix_pattern"
          ],
          "additionalProperties": false,
          "properties": {
            "phone_pattern": {
              "$ref": "#/$defs/regexSpec"
            },
            "booking_hour_fallback_pattern": {
              "$ref": "#/$defs/regexSpec"
            },
            "time_token_pattern": {
              "$ref": "#/$defs/regexSpec"
            },
            "daypart_token_pattern": {
              "$ref": "#/$defs/regexSpec"
            },
            "specialist_prefix_pattern": {
              "$ref": "#/$defs/regexSpec"
            }
          }
        },
        "replacement_patterns": {
          "type": "object",
          "required": [
            "relative_day_token_patterns",
            "daypart_token_patterns"
          ],
          "additionalProperties": false,
          "properties": {
            "relative_day_token_patterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/regexReplacementSpec"
              }
            },
            "daypart_token_patterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/regexReplacementSpec"
              }
            }
          }
        },
        "tokens": {
          "type": "object",
          "required": [
            "datetime_duration_context_markers",
            "datetime_daypart_stems"
          ],
          "additionalProperties": false,
          "properties": {
            "datetime_duration_context_markers": {
              "$ref": "#/$defs/textList"
            },
            "datetime_daypart_stems": {
              "$ref": "#/$defs/textList"
            }
          }
        },
        "layout_swap_map": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          }
        }
      }
    },
    "info": {
      "type": "object",
      "required": [
        "regex"
      ],
      "additionalProperties": false,
      "properties": {
        "regex": {
          "type": "object",
          "required": [
            "tokenize_word_pattern"
          ],
          "additionalProperties": false,
          "properties": {
            "tokenize_word_pattern": {
              "$ref": "#/$defs/regexSpec"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "textList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "regexFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "IGNORECASE",
          "MULTILINE",
          "DOTALL"
        ]
      }
    },
    "regexSpec": {
      "type": "object",
      "required": [
        "pattern"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "$ref": "#/$defs/regexFlags"
        }
      }
    },
    "regexReplacementSpec": {
      "type": "object",
      "required": [
        "pattern",
        "replacement"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "replacement": {
          "type": "string"
        },
        "flags": {
          "$ref": "#/$defs/regexFlags"
        }
      }
    }
  }
}
