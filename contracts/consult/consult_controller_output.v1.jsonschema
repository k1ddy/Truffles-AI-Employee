{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "consult_controller_output.v1",
  "type": "object",
  "required": [
    "intent",
    "topic_id",
    "confidence",
    "risk_class",
    "actions"
  ],
  "properties": {
    "intent": {
      "enum": [
        "consult",
        "info",
        "booking",
        "handoff",
        "out_of_domain"
      ]
    },
    "topic_id": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_class": {
      "enum": [
        "low",
        "medium",
        "high",
        "blocked"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "answer",
          "clarify",
          "handoff"
        ]
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
