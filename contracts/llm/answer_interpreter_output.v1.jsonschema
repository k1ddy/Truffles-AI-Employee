{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "answer_interpreter_output.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["slot", "confidence"],
  "properties": {
    "slot": {"type": "string"},
    "value": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string"}
  }
}
