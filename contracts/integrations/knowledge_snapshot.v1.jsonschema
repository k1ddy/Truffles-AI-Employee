{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truffles.ai/contracts/integrations/knowledge_snapshot.v1.jsonschema",
  "title": "Knowledge Snapshot v1",
  "type": "object",
  "required": [
    "snapshot_id",
    "tenant_context",
    "version_id",
    "schema_version",
    "created_at",
    "sha256",
    "packs"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_context": {
      "$ref": "../tenancy/tenant_context.v1.jsonschema"
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "minLength": 1
    },
    "packs": {
      "type": "object",
      "required": ["compiled_pack"],
      "properties": {
        "compiled_pack": {"type": "object"}
      },
      "additionalProperties": true
    },
    "signature": {
      "type": ["object", "null"],
      "properties": {
        "algorithm": {"type": "string"},
        "value": {"type": "string"},
        "key_id": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
