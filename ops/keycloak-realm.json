{
    "realm": "truffles",
    "enabled": true,
    "users": [
        {
            "username": "admin",
            "enabled": true,
            "credentials": [
                {
                    "type": "password",
                    "value": "admin"
                }
            ],
            "realmRoles": [
                "admin"
            ]
        }
    ],
    "clients": [
        {
            "clientId": "console-web",
            "enabled": true,
            "publicClient": false,
            "secret": "console-client-secret",
            "redirectUris": [
                "http://localhost:3000/*",
                "http://192.168.5.27:3000/*",
                "https://console.truffles.kz/*"
            ],
            "webOrigins": [
                "http://localhost:3000",
                "http://192.168.5.27:3000",
                "https://console.truffles.kz"
            ],
            "standardFlowEnabled": true,
            "directAccessGrantsEnabled": true,
            "serviceAccountsEnabled": true,
            "authorizationServicesEnabled": true,
            "protocolMappers": [
                {
                    "name": "console-web-audience",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "config": {
                        "included.client.audience": "console-web",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "userinfo.token.claim": "false"
                    }
                }
            ]
        }
    ]
}
